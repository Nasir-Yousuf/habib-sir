# ==============================================================================
# BONGO TANBO TRAVELS - PRODUCTION ENVIRONMENT TEMPLATE
# Copy this file to .env on your production VPS or shared cPanel server.
# NEVER commit your actual .env containing real production passwords to git!
# ==============================================================================

APP_NAME="Bongo Tanbo Travels"
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://bongotanbotravels.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# Database Configuration (Provide your hosting MySQL credentials)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bongotanbo_db
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_db_password

# Session & Security Hardening
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# File Storage
FILESYSTEM_DISK=public

# Cache & Queues
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Email Configuration (SMTP for live contact messages & booking notifications)
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=bongotanbo@gmail.com
MAIL_PASSWORD="your-google-app-password"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="bongotanbo@gmail.com"
MAIL_FROM_NAME="Bongo Tanbo Travels"
